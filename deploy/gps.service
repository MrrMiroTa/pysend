[Unit]
Description=GPS Expiry Notifier
After=network.target mariadb.service

[Service]
User=gps
Group=gps
WorkingDirectory=/opt/gps_notifier
Environment=PLAYWRIGHT_BROWSERS_PATH=/opt/gps_notifier/browsers
ExecStart=/opt/gps_notifier/.venv/bin/python app.py
Restart=always
RestartSec=5
# basic hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/gps_notifier

[Install]
WantedBy=multi-user.target
