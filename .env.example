# Copy to .env (local) or set these in Render -> Environment. NEVER commit the real values.
SECRET_KEY=                 # python -c "import secrets;print(secrets.token_hex(32))"
ADMIN_USER=admin            # this account always has every permission
ADMIN_PASSWORD_HASH=        # python app.py hash   (paste the whole scrypt:... text)
API_ID=
API_HASH=
TELEGRAM_SESSION_STRING=    # python scripts/make_session_string.py
CONTACT_PHONE=
DATABASE_URL=               # optional (Neon/Postgres). Empty = local SQLite
TIMEZONE=Asia/Phnom_Penh
COOKIE_SECURE=1             # 1 when the site is served over https (Render does)
TRUST_PROXY=1               # 1 behind Render/Nginx so the real client IP is used
